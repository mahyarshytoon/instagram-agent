APP_NAME="Instagram Agent (Testing)"
APP_ENV=testing
APP_KEY=base64:DNi2ysR2T+ALqE7au6VZCBvQeLQPgi0ehcWf9Xqq+9w=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://instagram-agent.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ═══ دیتابیس تست (جدا از اصلی) ═══
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instagram_agent_test
DB_USERNAME=root
DB_PASSWORD=

# ═══ Cache و Queue ═══
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# ═══ Redis (اگه استفاده می‌کنی) ═══
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ═══ Instagram (تستی) ═══
INSTAGRAM_APP_ID=test_app_id
INSTAGRAM_APP_SECRET=test_app_secret
INSTAGRAM_VERIFY_TOKEN=test_verify_token
INSTAGRAM_ACCESS_TOKEN=test_access_token
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_TIMEOUT=5

# ═══ AI (تستی) ═══
AI_PROVIDER=openai
AI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=test_openai_key
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.7
AI_TIMEOUT=5

# ═══ Agent ═══
AGENT_MAX_COMMENTS_PER_MINUTE=10
AGENT_MAX_COMMENTS_PER_USER_PER_HOUR=5
AGENT_MIN_COMMENT_LENGTH=2
AGENT_MAX_COMMENT_LENGTH=500